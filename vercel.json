{
 "framework":"vite",
 "buildCommand":"npm run build",
 "outputDirectory":"dist",
 "functions":{"api/proxy.js":{"maxDuration":30}},
 "rewrites":[
  {"source":"/api/:path*","destination":"/api/proxy?__api_path=:path*"},
  {"source":"/en/:path*","destination":"/index.html"},
  {"source":"/ar/:path*","destination":"/index.html"},
  {"source":"/invite/:path*","destination":"/index.html"},
  {"source":"/admin/:path*","destination":"/index.html"},
  {"source":"/client/:path*","destination":"/index.html"},
  {"source":"/preview/:path*","destination":"/index.html"},
  {"source":"/terms","destination":"/index.html"},
  {"source":"/privacy","destination":"/index.html"}
 ]
}
